{
  "title": "8BitDo Zero 2 — Wispr Flow + Claude Code",
  "rules": [
    {
      "description": "Zero 2 — Navigation + Cmd layer (D-pad arrows; m hold = Cmd layer: D-pad ⇄ apps, ↑↓ = scroll (⌘PageUp/Dn), k = Cmd+Enter)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "c", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "tab" }],
          "conditions": [
            { "type": "variable_if", "name": "zero2_app_switcher", "value": 1 },
            { "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "tab", "modifiers": ["left_shift"] }],
          "conditions": [
            { "type": "variable_if", "name": "zero2_app_switcher", "value": 1 },
            { "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "return_or_enter" }],
          "conditions": [
            { "type": "variable_if", "name": "zero2_app_switcher", "value": 1 },
            { "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "e", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "page_up" }],
          "conditions": [
            { "type": "variable_if", "name": "zero2_app_switcher", "value": 1 },
            { "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "f", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "page_down" }],
          "conditions": [
            { "type": "variable_if", "name": "zero2_app_switcher", "value": 1 },
            { "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "e", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "up_arrow" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "f", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "down_arrow" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_arrow" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "c", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "right_arrow" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "m", "modifiers": { "optional": ["any"] } },
          "to": [
            { "set_variable": { "name": "zero2_app_switcher", "value": 1 } },
            { "key_code": "left_command", "lazy": true }
          ],
          "to_if_alone": [{ "key_code": "return_or_enter" }],
          "to_after_key_up": [{ "set_variable": { "name": "zero2_app_switcher", "value": 0 } }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        }
      ]
    },
    {
      "description": "Zero 2 — Wispr Flow (k = hands-free Fn+Space, j = push-to-talk Ctrl+Opt)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "spacebar", "modifiers": ["fn"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_control", "modifiers": ["left_option"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        }
      ]
    },
    {
      "description": "Zero 2 — Terminal & app switching (g = open Terminal, h = Cmd+grave, i = Cmd+Tab)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "g", "modifiers": { "optional": ["any"] } },
          "to": [{ "shell_command": "open -a Terminal" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "grave_accent_and_tilde", "modifiers": ["left_command"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "i", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "tab", "modifiers": ["left_command"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 11720, "product_id": 36888 }] }]
        }
      ]
    }
  ]
}
