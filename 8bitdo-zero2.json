{
  "title": "8BitDo Zero 2 — Wispr Flow + Claude Code",
  "rules": [
    {
      "description": "Zero 2 — Navigation (D-pad arrows + Enter on m)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "e" },
          "to": [{ "key_code": "up_arrow" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "f" },
          "to": [{ "key_code": "down_arrow" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "d" },
          "to": [{ "key_code": "left_arrow" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "c" },
          "to": [{ "key_code": "right_arrow" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "m" },
          "to": [{ "key_code": "return_or_enter" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        }
      ]
    },
    {
      "description": "Zero 2 — Wispr Flow (k = push-to-talk Ctrl+Opt, j = hands-free Fn+Space)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "k" },
          "to": [{ "key_code": "left_control", "modifiers": ["left_option"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "j" },
          "to": [{ "key_code": "spacebar", "modifiers": ["fn"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        }
      ]
    },
    {
      "description": "Zero 2 — Terminal & app switching (g = open Terminal, h = Cmd+grave, i = Cmd+Tab)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "g" },
          "to": [{ "shell_command": "open -a Terminal" }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "h" },
          "to": [{ "key_code": "grave_accent_and_tilde", "modifiers": ["left_command"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "i" },
          "to": [{ "key_code": "tab", "modifiers": ["left_command"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 1234, "product_id": 5678 }] }]
        }
      ]
    }
  ]
}
